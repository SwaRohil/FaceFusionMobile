<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose owns the real theme (see ui/theme/Theme.kt). This platform theme only has to be
         dark, draw edge to edge and stay out of the way of the splash screen. -->
    <style name="Theme.SwapStudio" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/studio_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">@color/studio_accent</item>
    </style>
</resources>
